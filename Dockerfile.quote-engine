# ─── Quote Engine Dockerfile ─────────────────────────────────────────────────
# Multi-stage build for Python FastAPI Quote Engine
# Serves both BuildStack Construction and Broom Service

FROM python:3.11-slim as base

# Set environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for layer caching
COPY requirements-quote-engine.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-quote-engine.txt

# Copy application code
COPY main.py models.py schemas.py ./
COPY services/ ./services/
COPY templates/ ./templates/

# Create upload directory for photos
RUN mkdir -p /app/uploads/quotes /app/static/uploads

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
