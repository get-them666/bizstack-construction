# ─── BizStack Quote Engine — Environment Configuration ───────────────────────
# Copy this file to quote-engine.env and fill in your values.
# NEVER commit quote-engine.env to Git.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection (set automatically by docker-compose.yml)
# DATABASE_URL=postgresql://quote_engine:PASSWORD@db-quote-engine:5432/quote_engine
QUOTE_ENGINE_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ─── Vision AI (at least one required) ───────────────────────────────────────
# Google Gemini API key (recommended — fast + free tier)
GEMINI_API_KEY=
# OpenAI API key (fallback if Gemini fails)
OPENAI_API_KEY=

# ─── Admin Authentication ────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ─── Cal.com Scheduling ──────────────────────────────────────────────────────
# Event slugs from your Cal.com account (format: username/event-type)
CALCOM_CONSTRUCTION_EVENT_SLUG=bizstack/free-walkthrough
CALCOM_BROOM_EVENT_SLUG=broom-service/str-cleaning
# Webhook signing secret from Cal.com webhook settings
CALCOM_WEBHOOK_SECRET=

# ─── Payment (Zelle / ACH only — NO Stripe) ──────────────────────────────────
ZELLE_HANDLE=hello@bizstackperks.com
ACH_ROUTING=000000000
ACH_ACCOUNT=000000000000
BANK_NAME=BizStack Perks LLC

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@bizstackperks.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
FROM_ADDRESS=hello@bizstackperks.com
FROM_NAME=BizStack Perks
OWNER_EMAIL=hello@bizstackperks.com

# ─── Review Platform URLs ────────────────────────────────────────────────────
# Google Business Profile review link
GOOGLE_REVIEW_URL=https://g.page/broom-service-chesapeake/review
# Facebook Page reviews URL
FACEBOOK_REVIEW_URL=https://www.facebook.com/buildstackconstruction/reviews/
# Yelp business review URL
YELP_REVIEW_URL=https://www.yelp.com/biz/broom-service-chesapeake

# ─── Google Business Profile API (for social posting) ────────────────────────
# OAuth2 credentials for Google My Business API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Facebook Graph API (for social posting) ─────────────────────────────────
# Facebook Page access token (long-lived)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ─── Application ─────────────────────────────────────────────────────────────
BASE_URL=https://bizstackperks.com
UPLOAD_DIR=/app/uploads/quotes
