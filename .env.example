# ============================================================================
# Buildstack Construction Co. — environment
# Sister company to Broom Service. Same stack, separate repo + deploy.
# ============================================================================

# --- Required for production ------------------------------------------------
DATABASE_URL=postgresql://...
ADMIN_EMAIL=hello@bizstackperks.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# OTP is emailed to ADMIN_EMAIL; override recipient (e.g. a shared inbox)
ADMIN_OTP_EMAIL=
ADMIN_NAME=Owner
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
# Set "false" only to skip email codes during local dev
OTP_ENABLED=true

# --- Company identity (shown on the site + used in the AI assistant) --------
COMPANY_NAME=Buildstack Construction Co.
COMPANY_PHONE=+1 (757) 908-7121
COMPANY_EMAIL=hello@bizstackperks.com
COMPANY_DOMAIN=construction.bizstackperks.com
# Contractor license number shown in the footer/trust badges (optional)
CONTRACTOR_LICENSE=
SERVICE_AREA=Williamsburg–Hampton Roads, VA · Currituck County & Elizabeth City, NC

# --- Optional ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
APP_TIMEZONE=America/New_York

# --- SignalWire (voice & SMS for the AI assistant; reuse the Broom number) --
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=yourspace.signalwire.com
SIGNALWIRE_PHONE=+17578469275

# --- Stripe (project deposits) ---------------------------------------------
# LIVE account is acct_1UAeKoJ6MbAT3Jcc ("BuildStack Construction") -- the
# account all four webhook endpoints were created on. Keys live in Railway, not
# here. The old account acct_1U21rk7FqkxpR5Dt had charges/payouts enabled but
# only ever 3 FAILED charges and 4 payout_failures (bank rejected withdrawals),
# so it produced no payment history and was not usable as income evidence.
STRIPE_SECRET_KEY=sk_test_...
# Unused: nothing loads Stripe.js, checkout is server-created + redirected to.
STRIPE_PUBLISHABLE_KEY=
# From the endpoint for THIS service's /api/payments/webhook. The two brands
# have different secrets -- using the wrong one 400s every event.
#   construction -> we_1UNNMNJ6MbAT3JccolNX76Dc
#   bizstackperks -> we_1UNNMNJ6MbAT3JccAw20YIYy
STRIPE_WEBHOOK_SECRET=whsec_...
APP_BASE_URL=
# Default deposit amount (USD) to reserve a project / book a site survey
STRIPE_DEPOSIT_PRICE=500.00

# --- Stripe Connect (crew direct deposit) ----------------------------------
# MUST be a real whsec_ signing secret from the connect-webhook endpoint. A
# value without that prefix fails verification on every event. Leave blank in
# local dev only: the webhook then returns a harmless no-op.
#   construction -> we_1UNNMOJ6MbAT3JccR5Ms69nj
#   bizstackperks -> we_1UNNMOJ6MbAT3Jcc5UYJ1SSa
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Instant quote (property data + permits) -------------------------------
# RentCast powers address -> sqft/beds/baths/year-built lookups (free tier ok).
# Also backs skiptrace_service.py (owner of record). IMPORTANT: the Developer
# plan allows 50 calls per MONTH, shared between both uses. skiptrace caches
# every lookup on the normalized address -- misses included -- so repeats are
# free. Blank means skip traces return "no record", not an error.
#
# The enrichment controls that govern those calls (SKIPTRACE_ENRICH_MAX,
# RENTCAST_PREFILTER_MAX_CALLS) are in the Owner lookup section below.
RENTCAST_API_KEY=
# Shovels.ai powers the Job Finder (issued building permits in service cities).
# If blank, job-leads falls back to deterministic demo data for Williamsburg area.
SHOVELS_API_KEY=

# --- Ballpark estimate tuning (USD units, defaults shown) ------------------
# Interior refresh / drywall & paint / whole-home: per interior sq ft
EST_WHOLE_HOME_LOW=95.00
EST_WHOLE_HOME_HIGH=175.00
EST_REFRESH_LOW=12.00
EST_REFRESH_HIGH=35.00
EST_DRYWALL_LOW=7.00
EST_DRYWALL_HIGH=15.00
# Roofing & siding: per roof square (100 sq ft)
EST_ROOF_LOW=650.00
EST_ROOF_HIGH=1200.00
# Kitchen / bath / deck & fence: per project
EST_KITCHEN_LOW=18000.00
EST_KITCHEN_HIGH=45000.00
EST_BATH_LOW=9000.00
EST_BATH_HIGH=25000.00
EST_FENCE_LOW=2500.00
EST_FENCE_HIGH=12000.00

# --- SMTP (OTP login codes + estimate/deposit email) ------------------------
# NOTE: the lead bot does NOT send over SMTP. Gmail is the only lead transport
# (EMAIL_TRANSPORT=gmail, the default) because SES sits in a sandbox that cannot
# mail external recipients and Railway's egress times out on every Zoho port.
#
# DO NOT add SMTP_HOST "to fix" email. smtp_configured() used to require it,
# which silently blocked every send with "email not configured" while the Gmail
# transport worked fine behind it -- the reply bot, the lead sweep and manual
# draft firing were all dead. It is now transport-aware and only needs a
# sending address. If email is failing, check SENDER_PHYSICAL_ADDRESS and the
# Gmail OAuth token, not SMTP_HOST.
#
# These vars are still required for OTP login codes on the separate SMTP path,
# which does not use the Gmail transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@bizstackperks.com
SMTP_NAME=Buildstack Construction
# true (STARTTLS), false (no encryption), or ssl (implicit TLS on 465)
SMTP_TLS=true

# --- CAN-SPAM footer on every outbound message ------------------------------
# Appended to every email sent through the Gmail transport. Commercial email to
# US recipients legally requires a valid physical postal address and a working
# opt-out; this was empty, so every message sent until 2026-10-03 went out
# with neither. Set it.
SENDER_PHYSICAL_ADDRESS=Buildstack Construction Co., 701 Dana Dr, Chesapeake, VA 23321. To stop receiving email from us, reply "unsubscribe" and we will remove your address.

# --- RudderStack analytics (server-side, optional) --------------------------
# analytics_service.py ingests three events: page_view, instant_quote_started,
# instant_quote_submitted. Tracking is deliberately server-side so no
# credential is ever served to a browser.
#
# UNVERIFIED: the key previously supplied (…44Ea) is rejected by the data plane
# with "invalid write key" (401), as is the second one (…H5WR), on /v1/track,
# /v1/import and basic auth. Both are set in Railway but nothing is wired up,
# because neither is a valid write key for this data plane URL. Get the Write
# Key and Data Plane URL from Sources -> your source -> Settings in the
# RudderStack dashboard before enabling anything. Server-side only: a write key
# in a browser snippet is public, and a secret key in a browser snippet is a
# breach.
RUDDERSTACK_WRITE_KEY=
RUDDERSTACK_DATA_PLANE_URL=

# --- Owner lookup / skip trace (skiptrace_service.py) ------------------------
# RentCast powers address -> owner of record. IMPORTANT: the Developer plan
# allows 50 calls per MONTH, shared with instant-quote. Every lookup is cached
# on the normalized address, misses included, so repeats are free.
#
# Enrichment of address-only leads is OFF (0) pending a real hit rate. An
# unfiltered run spent 25 calls to update zero names before the cause was found;
# see MEMORY.md. Raise it in small steps, not to 25.
SKIPTRACE_ENRICH_MAX=0
# Cap on RentCast calls per skip_sherpa.py prefilter run (separate budget).
RENTCAST_PREFILTER_MAX_CALLS=20
# Skip Sherpa is what actually produces an EMAIL for a lead -- the assessor
# record behind the skip trace has no email and no phone. Unset: nothing is
# traced and no credits are spent.
SKIP_SHERPA_API_KEY=

# People Data Labs (PDL) -- free 100 person lookups per month, and the path
# skip_sherpa_service is NOT needed when PDL already has the contact. This is
# the provider skiptrace_contact tries FIRST; skip_sherpa is the fallback.
# Get a key at https://peopledatalabs.com
PDL_API_KEY=

# --- REsimpli (investor CRM, resimply_service.py) ---------------------------
# Optional. Downstream of this app: a lead pushed here is also visible to the
# deal team. Nothing here is required for the /skiptrace owner-contact flow.
#
# UNVERIFIED: the Open API token in the REsimpli settings screenshot answers
# 401 "Record not found!" on every endpoint -- byte-identical to a random
# string, while a missing header returns a different error. So the header
# reaches the server but matches no integration record. Either the key belongs
# to a different REsimpli account, or 6.0 has not issued one for this account.
# Confirm with REsimpli before relying on the push.
#
# The Open API Token, not the Zapier API Token. Auth is `Authorization: Bearer`.
RESIMPLY_API_TOKEN=
# lead/add requires four account-scoped ObjectIds as mandatory strings. Read
# them from THIS account via marketingCampaignList, marketList and
# getPipelineList -- they cannot be guessed. The push refuses and says which
# are missing rather than sending a malformed record.
RESIMPLY_CAMPAIGN_ID=
RESIMPLY_MARKET_ID=
RESIMPLY_PIPELINE_ID=
RESIMPLY_STATUS_ID=

# --- Outbound volume caps (auto_reply.py) -----------------------------------
# Gmail caps the SENDING MAILBOX at ~500 messages/day and suspends the mailbox
# when it is exceeded. That ceiling is SHARED by every sender on this account:
# the lead bot, the SBA lender sequence, owner notifications and anything sent
# by hand. Leave headroom rather than budgeting all of it to leads.
# 0 means UNCAPPED (auto_reply._channel_allowed treats cap<=0 as allowed), so
# leave these set to real numbers rather than 0.
EMAIL_DAILY_CAP=150
TEXT_DAILY_CAP=30

# --- Print-and-mail letters for address-only leads (mail_letters.py) --------
# Leads with a postal address but no email/phone cannot be reached by the
# email/text cadence, so they get a printed letter instead. That letter is the
# lead's FIRST touch and counts against the same once-then-5-days policy.
# Company street address and license number are not recorded anywhere in this
# repo yet; every PDF prints a "letterhead incomplete" warning until they are
# set, because a letter without a return address cannot be actioned if it
# bounces.
LETTER_BRAND_NAME=BizStack
LETTER_BRAND_LEGAL=Buildstack Construction
LETTER_BRAND_PHONE=252-665-5891
LETTER_BRAND_EMAIL=hello@bizstackperks.com
LETTER_BRAND_WEB=bizstackperks.com
LETTER_BRAND_STREET=701 Dana Dr
LETTER_BRAND_CITYSTATEZIP=Chesapeake, VA 23321
LETTER_BRAND_LICENSE=
LETTER_SENDER_NAME=Shaun O'Leary

# --- Materials live-price book (materials_service.py) ----------------------
MATERIALS_API_URL=https://data.gov/api/v1/materials
MATERIALS_API_KEY=
MATERIALS_CACHE_MINUTES=360

# --- Public lead-source scan (SAM.gov contract opportunities) ----------------
# Scans SAM.gov by NAICS for local public contracts and turns matches into
# leads. Owner-review mode by default: every new lead emails a ready-to-send
# bid-inquiry draft to NOTIFY_EMAIL (hello@, always deliverable). Auto-sending
# directly to the posted POC is OFF by default — direct sends were unreliable
# under SES sandbox + the Resend daily quota cap.
# NOTIFY_EMAIL wins over ADMIN_EMAIL for delivery; both fall back to hello@.
NOTIFY_EMAIL=hello@bizstackperks.com
LEAD_SOURCE_AUTO_EMAIL=off
LEAD_SOURCE_OWNER_DIGEST=on
LEAD_SOURCE_PRESET=construction
LEAD_STATES=VA,NC
LEAD_SCAN_INTERVAL_HOURS=6
# Federal source; off by default. Set to 1 to re-enable.
LEAD_SOURCES_SAM_GOV=0

# --- Scrap.io Maps lead source ------------------------------------------------
# Local-business (supply-side) leads: roofing/GC/HVAC/plumber/cleaning firms
# from Google Maps, enriched with a real business-domain email. Off by default
# because every search and every enrichment spends credits.
LEAD_SOURCES_SCRAP_IO=0
SCRAP_IO_API_KEY=
# "City,ST" pairs, semicolon- or newline-separated. Search is city-level only
# on the Basic plan; there is no county or statewide sweep.
SCRAP_IO_CITIES=Arlington,VA;Richmond,VA
# Scrap.io type ids, max 5 per search. Resolve ids with
#   python3 -c "import scrap_io; print(scrap_io.resolve_types('roofing'))"
SCRAP_IO_TYPES=general-contractor|roofing-contractor|hvac-contractor|plumber|electrician
SCRAP_IO_PAGES=2
# Enrichment costs 1 credit per business. Capped so a wide sweep cannot drain
# a month's allowance in one run.
SCRAP_IO_ENRICH=1
SCRAP_IO_ENRICH_MAX=25
# Falls back to LEAD_STATES when unset.
SCRAP_IO_STATES=VA,NC

# --- Accurate Append (contact append: name + address -> email + phone) ------
# The step the owner lookup cannot do. RentCast returns an owner NAME from the
# assessor record; no public record contains an email, so a consumer contact
# database is the only way to turn that name into something you can send to.
#
# BLOCKED as of 2026-10-03: the configured key is recognised (a wrong key
# returns "License key is required") but the ACCOUNT has no active subscription,
# so AppendEmail and AppendPhone both return 401 "You do not have an active
# subscription". The account needs its trial/subscription activated before any
# lookup will return data.
#
# Match levels E1/E2 (exact) and N1/N2 (name) are used. B1/B2 household-level
# matches are excluded on purpose -- they are frequently a different adult at
# the same address, and writing one against a named lead means calling a
# stranger believing them to be a customer.
ACCURATE_APPEND_API_KEY=
